# --- HQ (hq.tradenotes.dev) — owner-only internal app. Separate Vercel project, root directory = hq ---
# Same Postgres as the customer app (owner connection; needs read access to tradenotes.* and write to hq.*).
DATABASE_URL=
DATABASE_SSL_CA=
# Owner login. Generate the hash with:  cd hq && node scripts/hash-password.mjs
HQ_OWNER_EMAIL=
HQ_PASSWORD_HASH=
# Generate: openssl rand -base64 32   (signs the session cookie)
HQ_SESSION_SECRET=
# Optional but recommended: base32 TOTP secret (authenticator app). Generate: node scripts/hash-password.mjs --totp
HQ_TOTP_SECRET=
# Public customer site (used to build tagged links)
NEXT_PUBLIC_SITE_URL=https://tradenotes.dev
# Email for nurture sends (Resend). Leave empty to keep sending disabled.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
