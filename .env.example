# Neon (or any Postgres). Use the POOLED connection string on Vercel. Include ?sslmode=require
DATABASE_URL=
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site URL (no trailing slash), e.g. https://tradenotes.dev
BETTER_AUTH_URL=
NEXT_PUBLIC_SITE_URL=
# Optional until you want email confirmation + password reset (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
# Email (Resend) — set RESEND_API_KEY only AFTER the sending domain shows "Verified" (see docs/RESEND_SETUP.md)
# EMAIL_FROM="TradeNotes <noreply@yourdomain>"
# EMAIL_REPLY_TO=support@yourdomain
# HandyPay (payments). Start with the TEST key (hp_test_...). Without these the billing page uses static links + manual activation.
HANDYPAY_API_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/webhooks/handypay (HandyPay -> Webhooks)
HANDYPAY_WEBHOOK_SECRET=
# Optional: Supabase CA certificate (PEM) for verified TLS to the database
DATABASE_SSL_CA=
